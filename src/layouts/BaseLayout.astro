---
import '../styles/global.css'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
const {
  title,
} = Astro.props;
const description = "Charlotte, NC-based Belle Maison Interior Design, led by Gina Schorr, offers luxury residential interior design services with elegant, personalized spaces that reflect your unique style.";
const siteUrl = "https://bellemaisoninteriordesign.com";
const image = `${siteUrl}/apple-touch-icon.png`;
const canonical = `${siteUrl}${Astro.url.pathname}`;
const pageTitle = title ? `Belle Maison Interior Design - ${title} | Charlotte, NC` : "Belle Maison Interior Design - Charlotte's Premier Interior Design Firm";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Belle Maison Interior Design{title ? ' - ' + title : ''}</title>

    <!-- favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#515853" />
    <meta name="msapplication-TileColor" content="#515853" />
    <meta name="theme-color" content="#515853" />

    <!-- meta tags -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Gina Schorr" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Charlotte interior designer, luxury interior design, residential interior design, Charlotte NC, Belle Maison Interior Design" />
    <meta name="geo.region" content="US-NC" />
    <meta name="geo.placename" content="Charlotte" />
    <meta name="geo.position" content="35.2271;-80.8431" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:site_name" content="Belle Maison Interior Design" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Belle Maison Interior Design",
      "description": description,
      "image": image,
      "url": siteUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Charlotte",
        "addressRegion": "NC",
        "addressCountry": "US"
      }
    })}></script>

  </head>
  <body>
    <div class="overlay"></div>
    <Navigation />
    <main>
      <div>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
